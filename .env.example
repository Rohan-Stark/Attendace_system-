# SmartAttend Phase 1 Environment Variables

# Backend Configuration
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Frontend Configuration
FRONTEND_PORT=5173

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartattend
POSTGRES_PORT=5433

# JWT Authentication
JWT_SECRET_KEY=generate_a_secure_random_key_here
JWT_EXPIRATION_MINUTES=30
RESET_TOKEN_EXPIRATION_MINUTES=15

# Parent/Guardian Attendance Email Notifications
# Safe defaults: disabled and console provider (never contacts Resend).
# For safe demo mode: set PARENT_ATTENDANCE_EMAILS_ENABLED=true and EMAIL_PROVIDER=console
PARENT_ATTENDANCE_EMAILS_ENABLED=false
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_API_URL=https://api.resend.com
EMAIL_SEND_TIMEOUT_SECONDS=10.0
PARENT_EMAIL_MAX_ATTEMPTS=3
PARENT_NOTIFICATION_WORKER_ENABLED=true
PARENT_NOTIFICATION_WORKER_INTERVAL_SECONDS=60
PARENT_NOTIFICATION_STALE_SENDING_MINUTES=10

